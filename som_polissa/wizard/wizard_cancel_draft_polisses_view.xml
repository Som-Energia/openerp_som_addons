<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
        <record id="view_wizard_cancel_draft_polisses_form" model="ir.ui.view">
            <field name="name">wizard.cancel.draft.polisses.form</field>
            <field name="model">wizard.cancel.draft.polisses</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Cancel·lar pòlisses en esborrany antigues">
                    <field name="state" invisible="1"/>
                    <field name="info" colspan="4" nolabel="1" readonly="1"/>
                    <group colspan="4" attrs="{'invisible': [('state', '!=', 'init')]}">
                        <label string="Aquesta acció no es pot desfer." colspan="4"/>
                        <button name="action_cancel_draft_polisses" string="Executar" type="object" icon="gtk-ok"/>
                        <button special="cancel" string="Cancel·lar" icon="gtk-cancel"/>
                    </group>
                    <group colspan="4" attrs="{'invisible': [('state', '!=', 'done')]}">
                        <button special="cancel" string="Tancar" icon="gtk-close"/>
                    </group>
                </form>
            </field>
        </record>
        <record id="action_wizard_cancel_draft_polisses" model="ir.actions.act_window">
            <field name="name">Cancel·lar pòlisses en esborrany antigues</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">wizard.cancel.draft.polisses</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_wizard_cancel_draft_polisses_form"/>
            <field name="target">new</field>
        </record>
        <menuitem
            id="menu_wizard_cancel_draft_polisses"
            name="Cancel·lar pòlisses en esborrany antigues"
            parent="giscedata_polissa.menu_principal"
            action="action_wizard_cancel_draft_polisses"
            groups="giscedata_facturacio.group_giscedata_facturacio_u"
            sequence="20"/>
    </data>
</openerp>
