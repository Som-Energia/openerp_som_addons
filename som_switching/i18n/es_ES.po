#. module: som_switching
#. Runtime Mako template already selects Catalan/Spanish content; preserve recipient-language branching
#. and code.
#, python-format
msgid ""
"\n"
"                <%!\n"
"                    from mako.template import Template\n"
"\n"
"                    def render(text_to_render, object_):\n"
"                        templ = Template(text_to_render)\n"
"                        return templ.render_unicode(\n"
"                            object=object_,\n"
"                            format_exceptions=True\n"
"                    )\n"
"\n"
"                    def get_partner_name(object_):\n"
"                        p_obj = object_.pool.get('res.partner')\n"
"                        if not object_.vat_enterprise():\n"
"                            nom_titular =' ' + p_obj.separa_cognoms(object_._cr, object_._uid, "
"object_.cups_polissa_id.titular.name)['nom']\n"
"                        else:\n"
"                            nom_titular = ''\n"
"                        return nom_titular\n"
"                %>\n"
"                <%\n"
"                    polissa = object.cups_polissa_id\n"
"\n"
"                    t_obj = object.pool.get('poweremail.templates')\n"
"                    md_obj = object.pool.get('ir.model.data')\n"
"                    template_id = md_obj.get_object_reference(\n"
"                                        object._cr, object._uid,  "
"'som_poweremail_common_templates', 'common_template_legal_footer'\n"
"                                    )[1]\n"
"\n"
"                    text_legal = render(t_obj.read(\n"
"                        object._cr, object._uid, [template_id], "
"['def_body_text'])[0]['def_body_text'],\n"
"                        object\n"
"                    )\n"
"\n"
"                %>\n"
"                <!doctype html>\n"
"                <html>\n"
"                    <head>\n"
"                        <meta charset='utf-8'>\n"
"                    </head>\n"
"                    % if object.cups_polissa_id.titular.lang == \"ca_ES\":\n"
"                        ${correu_cat()}\n"
"                    % else:\n"
"                        ${correu_es()}\n"
"                    % endif\n"
"                    ${text_legal}\n"
"                </html>\n"
"\n"
"                <%def name=\"correu_cat()\">\n"
"                    <body>\n"
"                        <table width=\"100%\" frame=\"below\" bgcolor=\"#E8F1D4\">\n"
"                            <tr>\n"
"                                <td height=2px>\n"
"                                    <font size=2><strong> Contracte Som Energia nº "
"${polissa.name}</strong></font>\n"
"                                </td>\n"
"                                <td valign=top rowspan=\"4\" align=\"right\">\n"
"                                    <img width='130' height='65' "
"src=\"https://www.somenergia.coop/wp-content/uploads/2014/11/logo-somenergia.png\">\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td height=2px>\n"
"                                    <font size=1> Adreça punt subministrament: "
"${object.cups_id.direccio}</font>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td height=2px>\n"
"                                    <font size=1> Codi CUPS: ${object.cups_id.name}</font>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                        <p>\n"
"                            Hola${get_partner_name(object)},\n"
"                        </p>\n"
"                        <p>\n"
"                            Ens ha arribat la notificació que no estàs d’acord amb les dades que "
"ens ha passat l’empresa de distribució elèctrica referent a la teva instal·lació d’autoconsum "
"associada al CUPS ${object.cups_id.name} amb direcció de subministrament "
"${object.cups_id.direccio}.\n"
"                        </p>\n"
"                        <p>\n"
"                            Enviem el rebuig, amb el detall del motiu de desacord que ens has "
"indicat a través de la teva oficina virtual, a la distribuïdora.\n"
"                        </p>\n"
"                        <p>\n"
"                            Si es tracta d’un error en la comunicació per part de la "
"distribuïdora ens faran arribar una nova comunicació corregida, si pel contrari es tracta d’un "
"error a l’hora de fer el registre o de la comunicació per part de la Comunitat Autònoma cal que "
"contacteu amb la mateixa per tal de modificar la informació i que comenci el procés novament.\n"
"                        </p>\n"
"                        <p>\n"
"                            Malauradament, la distribuïdora no ens indica si es tracta d’una o "
"altra casuística pel que et recomanem que contactis directament amb la distribuïdora i el "
"departament corresponent de la teva Comunitat Autònoma per aclarir-ho.\n"
"                        </p>\n"
"                        <p>\n"
"                            Qualsevol dubte seguim en contacte.\n"
"                        </p>\n"
"                        Salutacions,<br>\n"
"                        <br>\n"
"                        Equip de Som Energia<br>\n"
"                        <a "
"href=\"mailto:modifica@somenergia.coop\">modifica@somenergia.coop</a><br>\n"
"                        <a href=\"http://www.somenergia.coop/ca\">www.somenergia.coop</a>\n"
"                    </body>\n"
"                </%def>\n"
"                <%def name=\"correu_es()\">\n"
"                    <body>\n"
"                        <table width=\"100%\" frame=\"below\" bgcolor=\"#E8F1D4\">\n"
"                            <tr>\n"
"                                <td height=2px>\n"
"                                    <font size=2><strong> Contrato Som Energia nº "
"${polissa.name}</strong></font>\n"
"                                </td>\n"
"                                <td valign=top rowspan=\"4\" align=\"right\">\n"
"                                    <img width='130' height='65' "
"src=\"https://www.somenergia.coop/wp-content/uploads/2014/11/logo-somenergia.png\">\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td height=2px>\n"
"                                    <font size=1> Dirección del punto de suministro: "
"${object.cups_id.direccio}</font>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td height=2px>\n"
"                                    <font size=1> Código CUPS: ${object.cups_id.name}</font>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                        <p>\n"
"                            Hola${get_partner_name(object)},\n"
"                        </p>\n"
"                        <p>\n"
"                            Nos ha llegado la notificación que no estás de acuerdo con los datos "
"que nos ha pasado la empresa de distribución eléctrica referente a tu instalación de autoconsumo "
"asociada al CUPS ${object.cups_id.name} con dirección de suministro ${object.cups_id.direccio}.\n"
"                        </p>\n"
"                        <p>\n"
"                            Enviamos el rechazo, con el detalle del motivo de desacuerdo que nos "
"has indicado a través de tu oficina virtual, a la distribuidora.\n"
"                        </p>\n"
"                        <p>\n"
"                            Si se trata de un error en la comunicación por parte de la "
"distribuidora nos harán llegar una nueva comunicación corregida, si por el contrario se trata de "
"un error a la hora de hacer el registro o de la comunicación por parte de la Comunidad Autónoma "
"deberás ponerte en contacto con la misma a fin de modificar la información y que comience el "
"proceso nuevamente.\n"
"                        </p>\n"
"                        <p>\n"
"                            Desgraciadamente, la distribuidora no nos indica si se trata de una u"
" otra casuística por lo que te recomendamos que contactes directamente con la distribuidora y el "
"departamento correspondiente de tu Comunidad Autónoma para aclararlo.\n"
"                        </p>\n"
"                        <p>\n"
"                            Cualquier duda seguimos en contacto.\n"
"                        </p>\n"
"                        Saludos,<br>\n"
"                        <br>\n"
"                        Equipo de Som Energia<br>\n"
"                        <a "
"href=\"mailto:modifica@somenergia.coop\">modifica@somenergia.coop</a><br>\n"
"                        <a href=\"http://www.somenergia.coop/es\">www.somenergia.coop</a>\n"
"                    </body>\n"
"                </%def>\n"
"                \n"
"            "
