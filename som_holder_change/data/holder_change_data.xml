<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data noupdate="1">
        <record id="email_signature_process_holder_change" model="poweremail.templates">
            <field name="name">Canvi de titular: firma de documents</field>
            <field name="object_name" model="ir.model"
                search="[('model', '=', 'som.holder.change.request')]"/>
            <field eval="0" name="save_to_drafts"/>
            <field name="model_int_name">som.holder.change.request</field>
            <field eval="0" name="use_filter"/>
            <field name="file_name" eval="False"/>
            <field name="def_to">${env['signature']['recipient']['email']}</field>
            <field name="def_subject">Sol·licitud de signatura del canvi de titular</field>
            <field name="lang"
                >${'es_ES' if env.get('signature', {}).get('lang') == 'es_ES' else 'ca_ES'}</field>
            <field name="template_language">mako</field>
            <field name="def_body_text"><![CDATA[<p>Signa el contracte i, si escau, el mandat SEPA:</p>
<p><a href="${env.get('signature', {}).get('signature_url', '')}" target="_blank" rel="noopener noreferrer">Signar documents</a></p>]]></field>
        </record>
        <record id="attachment_category_death" model="ir.attachment.category">
            <field name="code">holder_change_death</field>
            <field name="name">Holder change death certificate</field>
        </record>
        <record id="attachment_category_merge" model="ir.attachment.category">
            <field name="code">holder_change_merge</field>
            <field name="name">Holder change merger certificate</field>
        </record>
        <record id="attachment_category_medical" model="ir.attachment.category">
            <field name="code">holder_change_medical</field>
            <field name="name">Holder change medical certificate</field>
        </record>
    </data>
</openerp>
