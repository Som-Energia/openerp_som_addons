#. module: account_analytic_som
#: code:addons/account_analytic_som/wizard/wizard_reassign_move_analytics.py:0
msgid "Select exactly one journal entry."
msgstr "Seleccioneu exactament un assentament comptable."

#. module: account_analytic_som
#: code:addons/account_analytic_som/wizard/wizard_reassign_move_analytics.py:0
msgid "Confirm one reassignment at a time."
msgstr "Confirmeu una sola reassignació cada vegada."

#. module: account_analytic_som
#: code:addons/account_analytic_som/wizard/wizard_reassign_move_analytics.py:0
msgid "The journal items have changed. Reopen the wizard."
msgstr "Els apunts comptables han canviat. Torneu a obrir l'assistent."

#. module: account_analytic_som
#: code:addons/account_analytic_som/wizard/wizard_reassign_move_analytics.py:0
