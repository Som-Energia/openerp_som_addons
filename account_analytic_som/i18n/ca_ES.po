msgstr "No es pot accedir a l'assentament comptable."

#. module: account_analytic_som
#: code:addons/account_analytic_som/models/account_move.py:0
msgid "Select a posted entry with valid journal items."
msgstr "Seleccioneu un assentament confirmat amb apunts comptables vàlids."

#. module: account_analytic_som
#: code:addons/account_analytic_som/models/account_move.py:0
