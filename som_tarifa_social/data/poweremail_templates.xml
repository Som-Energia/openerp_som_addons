            <field name="model_int_name">giscedata.polissa</field>
            <field name="def_to">${object.direccio_pagament.email}</field>
            <field name="def_subject">Entrada a la tarifa social</field>
            <field name="template_language">mako</field>
            <field name="lang">${object.titular.lang}</field>
            <field name="def_bcc"></field>
            <field name="def_body_text"><![CDATA[
                <!doctype html>
                <html>
                <head></head>
                <body>
                Email text
                </body>
                </html>
                ]]>
            </field>
        </record>
