<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="view_giscedata_facturacio_factura_form_redsys" model="ir.ui.view">
            <field name="name">giscedata.facturacio.factura.form.redsys</field>
            <field name="model">giscedata.facturacio.factura</field>
            <field name="inherit_id" ref="giscedata_facturacio_comer.view_factura_form"/>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <field name="payment_mode_id" position="after">
                    <field name="is_recurrent_card_payment" invisible="1"/>
                </field>
                <xpath expr="//page[@string='Payments']/field[@name='payment_ids']" position="after">
                    <group
                        string="Cobrament Redsys"
                        colspan="4"
                        col="4"
                        attrs="{'invisible': [('is_recurrent_card_payment', '=', False)]}"
                    >
                        <field name="redsys_collection_state"/>
                        <field name="redsys_order_ref"/>
                        <field name="redsys_card_id"/>
                        <field name="redsys_amount_cents"/>
                        <field name="redsys_currency"/>
                        <field name="redsys_response_code"/>
                        <field name="redsys_response_message" colspan="4"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='partner_bank']" position="attributes">
                    <attribute name="attrs">
                        {'invisible': [('is_recurrent_card_payment', '=', True)]}
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='mandate_id']" position="attributes">
                    <attribute name="attrs">
                        {'invisible': [('is_recurrent_card_payment', '=', True)]}
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='payment_order_id']" position="attributes">
                    <attribute name="attrs">
                        {'invisible': [('is_recurrent_card_payment', '=', True)]}
                    </attribute>
                </xpath>
                <xpath expr="//field[@name='payment_order_history_ids']" position="attributes">
                    <attribute name="attrs">
                        {'invisible': [('is_recurrent_card_payment', '=', True)]}
                    </attribute>
                </xpath>
            </field>
        </record>
    </data>
</openerp>
