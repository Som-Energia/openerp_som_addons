<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data noupdate="0">
        <record model="ir.ui.view" id="price_change_lot_form">
            <field name="name">price.change.lot.form</field>
            <field name="type">form</field>
            <field name="model">som.infoenergia.lot.enviament</field>
            <field name="inherit_id" ref="som_infoenergia.view_som_enviament_massiu_lot_form"/>
            <field name="arch" type="xml">
                <field name="email_template" position="after">
                    <field name="price_change_selection_date"/>
                    <field name="price_change_old_price_date"/>
                    <field name="price_change_effective_date"/>
                </field>
            </field>
        </record>
        <record model="ir.ui.view" id="price_change_editor_form">
            <field name="name">price.change.editor.form</field>
            <field name="type">form</field>
            <field name="model">report.banner</field>
            <field name="arch" type="xml">
                <form string="Text de canvi de preus">
                    <field name="name" readonly="1"/>
                    <field name="code" readonly="1"/>
                    <field name="start_date" readonly="1"/>
                    <field name="end_date" readonly="1"/>
                    <separator string="HTML senzill, sense expressions ni codi executable" colspan="4"/>
                    <field name="html" nolabel="1" colspan="4"/>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="price_change_editor_tree">
            <field name="name">price.change.editor.tree</field>
            <field name="type">tree</field>
            <field name="model">report.banner</field>
            <field name="arch" type="xml">
                <tree string="Textos de canvi de preus">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </tree>
            </field>
        </record>
        <record model="ir.actions.act_window" id="price_change_editor_ca">
            <field name="name">Textos de canvi de preus (català)</field>
            <field name="res_model">report.banner</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="price_change_editor_tree"/>
            <field name="domain">[('code', 'in', ['CANVI_PREUS_MOTIU', 'CANVI_PREUS_AUTOCONSUM', 'CANVI_PREUS_COMIAT'])]</field>
            <field name="context">{'lang': 'ca_ES', 'form_view_ref': 'som_polissa_condicions_generals.price_change_editor_form'}</field>
        </record>
        <record model="ir.actions.act_window" id="price_change_editor_es">
            <field name="name">Textos de canvi de preus (castellà)</field>
            <field name="res_model">report.banner</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="price_change_editor_tree"/>
            <field name="domain">[('code', 'in', ['CANVI_PREUS_MOTIU', 'CANVI_PREUS_AUTOCONSUM', 'CANVI_PREUS_COMIAT'])]</field>
            <field name="context">{'lang': 'es_ES', 'form_view_ref': 'som_polissa_condicions_generals.price_change_editor_form'}</field>
        </record>
        <menuitem id="price_change_editor_ca_menu" action="price_change_editor_ca"
                  parent="som_infoenergia.menu_carpeta_massius" groups="group_price_change_editor"/>
        <menuitem id="price_change_editor_es_menu" action="price_change_editor_es"
                  parent="som_infoenergia.menu_carpeta_massius" groups="group_price_change_editor"/>
    </data>
</openerp>
