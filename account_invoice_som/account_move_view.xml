<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
        <record id="view_move_form_analytic_default" model="ir.ui.view">
            <field name="name">account.move.form.analytic.default</field>
            <field name="model">account.move</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='line_id']/form/field[@name='account_id']" position="attributes">
                    <attribute name="on_change">onchange_account_id(account_id, partner_id)</attribute>
                </xpath>
                <xpath expr="//field[@name='line_id']/form/field[@name='partner_id']" position="after">
                    <field name="analytic_account_id"/>
                </xpath>
            </field>
        </record>
    </data>
</openerp>
